# =========================
# 超声缺陷智能检测系统配置
# 复制本文件为 .env 后按实际情况修改。
# 路径推荐使用 ./data/... 这种相对路径，方便项目复制到其他电脑或服务器。
# =========================

# 系统运行环境：development=开发环境，production=正式环境
APP_ENV=development

# 后端服务地址与端口
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# 前端访问地址。开发环境通常是 Vite 默认端口 5173
FRONTEND_URL=http://localhost:5173

# 系统数据根目录。上传图片、检测输出、报告、数据库默认都放在这里
APP_DATA_DIR=./data

# 上传图片保存目录
UPLOAD_DIR=./data/uploads

# 检测结果、标注图、报告保存目录
OUTPUT_DIR=./outputs

# SQLite 数据库路径。单机和演示环境推荐使用 SQLite
# 正式多人部署可改为 PostgreSQL，例如：
# DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/inspection
DATABASE_URL=sqlite:///./data/app.db

# 实时处理中间缓存保留天数。到期后清理 MATLAB 分组输出和 TOFD 状态；
# 历史批次、复核记录、展示图片和正式报告不会删除。
REALTIME_CACHE_RETENTION_DAYS=7

# 缓存自动检查间隔（小时）。应用启动时也会检查一次。
REALTIME_CACHE_CLEANUP_HOURS=6

# =========================
# 大模型 Agent 配置
# =========================

# 是否启用 Agent 分析。true=启用，false=关闭
AGENT_ENABLED=false

# OpenAI-compatible API Key。不要把真实 key 提交给别人或上传到代码仓库
OPENAI_API_KEY=

# OpenAI-compatible API 地址。
# OpenAI 官方默认可用：https://api.openai.com/v1
# 如果使用兼容网关或私有化模型，填写对应的 /v1 地址
OPENAI_BASE_URL=https://api.openai.com/v1

# 大模型名称。按你的 API 服务实际支持的模型填写
OPENAI_MODEL=gpt-4o-mini

# Agent 输出语言
AGENT_LANGUAGE=zh-CN

# 是否把当前批次缺陷结果发送给大模型 API。关闭后 Agent 只能给通用建议。
AGENT_SEND_PROJECT_CONTEXT=true

# Agent 是否联网检索公开资料。没有搜索 API 时默认使用 DuckDuckGo HTML 检索，网络不可用时会自动降级。
WEB_SEARCH_ENABLED=true

# 是否把项目名称、检测对象、缺陷尺寸等上下文发送给搜索引擎。默认 false，更适合保密项目。
WEB_SEARCH_SEND_PROJECT_CONTEXT=false

# 可选：duckduckgo、serper、tavily、bing。正式部署建议接稳定搜索 API。
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_MAX_RESULTS=5

# 使用 serper/tavily/bing 等服务时填写；duckduckgo 可留空。
WEB_SEARCH_API_KEY=
WEB_SEARCH_API_URL=

# 报告默认信息，可在前端创建任务时覆盖
REPORT_ORG_NAME=
REPORT_PREPARED_BY=
REPORT_REVIEWED_BY=
REPORT_APPROVED_BY=
